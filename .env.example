# Google AI Studio에서 발급한 Gemini API 키 (https://aistudio.google.com/apikey)
# 실제 학생 자료를 다룬다면 결제(유료) 등급 키를 권장합니다. 무료 등급은 입력이 서비스 개선에 활용될 수 있습니다.
GEMINI_API_KEY=

# 먼저 시도할 모델 (비워 두면 gemini-3.8-flash → gemini-3.6-flash → gemini-3.5-flash-lite → gemini-2.5-flash → gemini-flash-latest 순서로 자동 전환)
GEMINI_MODEL=

# 서버 포트 (기본값: 5178)
PORT=5178
